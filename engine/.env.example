# Optional: the key is read from ../nebius_token.env by default. Setting it here overrides that.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# A vision model from the Token Factory catalogue, e.g. a Qwen VL or Gemma model.
# List available models: curl -H "Authorization: Bearer $(cat ../nebius_token.env)" https://api.tokenfactory.nebius.com/v1/models
VISION_MODEL=openbmb/MiniCPM-V-4_5
TEXT_MODEL=
# JSON list of frontend origins allowed by CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]
# Optional regex for origins that change per deploy, e.g. Vercel previews of the frontend:
# ALLOWED_ORIGIN_REGEX=https://<project>(-[a-z0-9-]+)?-<team>\.vercel\.app
ALLOWED_ORIGIN_REGEX=

# Leave empty to never store photos. Set a folder to keep uploads and results locally.
SAVE_UPLOADS_DIR=

# Used by scripts/tunnel.sh to point the Vercel frontend at a tunnel to this laptop.
# Token: https://vercel.com/account/tokens. Project and team IDs: project Settings > General.
# Deploy hook: project Settings > Git > Deploy Hooks (use the production branch).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_DEPLOY_HOOK=
