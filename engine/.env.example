# Optional: the key is read from ../nebius_token.env by default. Setting it here overrides that.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# A vision model from the Token Factory catalogue, e.g. a Qwen VL or Gemma model.
# List available models: curl -H "Authorization: Bearer $(cat ../nebius_token.env)" https://api.tokenfactory.nebius.com/v1/models
VISION_MODEL=openbmb/MiniCPM-V-4_5
TEXT_MODEL=
# JSON list of frontend origins allowed by CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]
# Leave empty to never store photos. Set a folder to keep uploads and results locally.
SAVE_UPLOADS_DIR=
